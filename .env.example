# Copy to .env and adjust values
# cp .env.example .env

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
DOCUMENTSERVER_TAG=latest

# -----------------------------------------------------------------------------
# Local FQDN (used by NPM and Nextcloud connector)
# -----------------------------------------------------------------------------
ONLYOFFICE_FQDN=onlyoffice.local

# -----------------------------------------------------------------------------
# Docker network (must already exist – used by Nginx Proxy Manager)
# -----------------------------------------------------------------------------
DOCKER_NETWORK=outside

# -----------------------------------------------------------------------------
# Volume paths (host side) – relative or absolute
# Defaults keep data next to the compose file
# -----------------------------------------------------------------------------
DATA_VOLUME=./data
LOGS_VOLUME=./logs
LIB_VOLUME=./lib
# CERTS_VOLUME=./certs          # only needed if SSL is terminated inside the container
# FONTS_VOLUME=./fonts

# -----------------------------------------------------------------------------
# Optional host ports (leave commented / unused when behind NPM)
# Uncomment in docker-compose.yml if you need direct access for debugging
# -----------------------------------------------------------------------------
# HTTP_PORT=8080
# HTTPS_PORT=8443

# -----------------------------------------------------------------------------
# JWT – MUST match the secret configured in the Nextcloud ONLYOFFICE connector
# Generate a strong value:  openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_ENABLED=true
JWT_SECRET=onlyoffice-jwt-secret-change-me
JWT_HEADER=Authorization
JWT_IN_BODY=false

# -----------------------------------------------------------------------------
# Required when Nextcloud uses a self-signed certificate
# -----------------------------------------------------------------------------
USE_UNAUTHORIZED_STORAGE=true

# -----------------------------------------------------------------------------
# SSL inside Document Server (normally leave disabled – terminate at NPM)
# -----------------------------------------------------------------------------
# SSL_CERTIFICATE_PATH=/var/www/onlyoffice/Data/certs/tls.crt
# SSL_KEY_PATH=/var/www/onlyoffice/Data/certs/tls.key
# SSL_DHPARAM_PATH=/var/www/onlyoffice/Data/certs/dhparam.pem
# ONLYOFFICE_HTTPS_HSTS_ENABLED=true
# ONLYOFFICE_HTTPS_HSTS_MAXAGE=31536000
